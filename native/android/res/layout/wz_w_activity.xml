<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/wz_root"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal"
    android:background="@drawable/wz_bg_green" android:padding="10dp" android:baselineAligned="false">
  <LinearLayout android:id="@+id/wz_steps_box" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
    <FrameLayout android:layout_width="74dp" android:layout_height="74dp">
      <ProgressBar android:id="@+id/wz_ring" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="match_parent"
          android:max="100" android:progress="0" android:indeterminate="false" android:progressDrawable="@drawable/wz_ring"/>
      <ImageView android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="center" android:src="@drawable/wz_ic_steps"/>
    </FrameLayout>
    <TextView android:id="@+id/wz_steps" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFFFF" android:textSize="17sp" android:textStyle="bold" android:maxLines="1" android:text="0"/>
    <TextView android:id="@+id/wz_steps_sub" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#D9FFFFFF" android:textSize="10sp" android:maxLines="1" android:text="-"/>
  </LinearLayout>
  <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
    <ImageView android:layout_width="26dp" android:layout_height="26dp" android:src="@drawable/wz_ic_water"/>
    <TextView android:id="@+id/wz_water" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFFFF" android:textSize="20sp" android:textStyle="bold" android:maxLines="1" android:text="0/8"/>
    <TextView android:id="@+id/wz_water_lbl" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#D9FFFFFF" android:textSize="10sp" android:maxLines="1" android:text="-"/>
    <TextView android:id="@+id/wz_water_add" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:background="@drawable/wz_btn_white"
        android:textColor="#FF0E9F5A" android:textSize="13sp" android:textStyle="bold" android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="4dp" android:paddingBottom="4dp" android:text="+1"/>
  </LinearLayout>
</LinearLayout>
