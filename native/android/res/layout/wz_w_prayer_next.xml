<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/wz_root"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center_vertical"
    android:background="@drawable/wz_bg_blue" android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingTop="8dp" android:paddingBottom="8dp">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
    <ImageView android:id="@+id/wz_next_ic" android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/wz_ic_zohor" android:layout_marginEnd="6dp"/>
    <TextView android:id="@+id/wz_next_name" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textColor="#FFFFFFFF" android:textSize="16sp" android:textStyle="bold" android:maxLines="1" android:text="-"/>
    <TextView android:id="@+id/wz_next_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFFFF" android:textSize="15sp" android:maxLines="1" android:text="-"/>
  </LinearLayout>
  <Chronometer android:id="@+id/wz_count" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFE066" android:textSize="30sp" android:textStyle="bold" android:fontFamily="sans-serif-medium"/>
  <TextView android:id="@+id/wz_zone" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#D9FFFFFF" android:textSize="11sp" android:maxLines="1" android:ellipsize="end" android:text="-"/>
</LinearLayout>
